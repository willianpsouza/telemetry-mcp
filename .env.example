# ==========================================================================
# Provengo Observability Framework - environment
# Copy to .env and adjust. This file is committed; .env is NOT (gitignored).
#
# Caddy is the single entrypoint; backends are not published to the host.
# Locally, *.localhost resolves to 127.0.0.1 so no DNS setup is needed:
#   http://obs.localhost  http://grafana.localhost  http://docs.localhost
# ==========================================================================

# --- Edge (Caddy + Cloudflare) ---
# Base domain for the per-service subdomains. "localhost" works out of the box.
# In production: your real domain, e.g. obs.example.com -> BASE_DOMAIN=example.com
BASE_DOMAIN=localhost
# Host port Caddy listens on (the Cloudflare Tunnel connects to caddy:80 instead).
EDGE_HTTP_PORT=80
# Cloudflare Tunnel token (only used with: docker compose --profile edge up -d)
CLOUDFLARE_TUNNEL_TOKEN=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
# Public URL Grafana serves itself under (match the grafana subdomain).
GRAFANA_ROOT_URL=http://grafana.localhost

# --- Registry / onboarding console + OTLP auth proxy ---
REGISTRY_ADMIN_USER=admin
REGISTRY_ADMIN_PASSWORD=change-me-too
# What the generated snippet tells apps to send telemetry to (the ingest host).
# Local: ingest.localhost on port 80. Production: ingest.<domain>, port 443, https.
REGISTRY_TELEMETRY_HOST=ingest.localhost
REGISTRY_INGEST_PORT=80
REGISTRY_INGEST_SCHEME=http

# --- MCP server ---
# Where it reads telemetry from (service DNS inside compose).
MCP_PROMETHEUS_URL=http://prometheus:9090
MCP_JAEGER_URL=http://jaeger:16686
MCP_LOKI_URL=http://loki:3100
MCP_DEFAULT_LOOKBACK=1h
MCP_HTTP_TIMEOUT=30s
# Bearer token required to call the MCP server over HTTP. Generate a long random
# value (e.g. openssl rand -hex 32). Empty = NO AUTH (only safe when internal).
MCP_AUTH_TOKEN=

# --- Prometheus retention ---
PROM_RETENTION=15d
