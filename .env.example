# ==========================================================================
# Provengo Telemetry Server - environment
# Copy to .env and adjust. This file is committed; .env is NOT (gitignored).
# ==========================================================================

# --- Published host ports (telemetry server) ---
# OTLP ingestion (services send telemetry here)
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Backends UI / query
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
LOKI_PORT=3100
GRAFANA_PORT=3000

# Collector self-metrics endpoint scraped by Prometheus
COLLECTOR_METRICS_PORT=8888
COLLECTOR_PROM_EXPORT_PORT=8889

# --- Grafana admin ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please

# --- Prometheus retention ---
PROM_RETENTION=15d

# ==========================================================================
# MCP server - where it reads telemetry from.
# When MCP runs inside docker-compose, use the service DNS names below.
# When MCP runs on your laptop against a remote telemetry server, set these
# to the server's address, e.g. http://telemetry.internal:9090
# ==========================================================================
MCP_PROMETHEUS_URL=http://prometheus:9090
MCP_JAEGER_URL=http://jaeger:16686
MCP_LOKI_URL=http://loki:3100

# Default time window for range queries when caller omits it
MCP_DEFAULT_LOOKBACK=1h
# Per-request HTTP timeout to backends
MCP_HTTP_TIMEOUT=30s
